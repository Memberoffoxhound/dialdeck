{
  admin off
}

:8080 {
  handle /api/* {
    reverse_proxy api:3000
  }

  handle /rtc* {
    reverse_proxy livekit:7880 {
      header_up Host {host}
      header_up Connection {>Connection}
      header_up Upgrade {>Upgrade}
      flush_interval -1
    }
  }

  handle {
    encode gzip
    reverse_proxy web:80
  }
}
